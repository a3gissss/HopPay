# --- Server only (never exposed to the browser) ---

# MultiHopper API key. Devnet keys (mh_test_) come from https://devnet.multihopper.com/developer/dashboard,
# production keys (mh_live_) from https://multihopper.com/developer/dashboard. Keys only work in the
# environment that issued them.
MH_API_KEY=mh_test_replace_me

# https://devnet.multihopper.com/api/v1 (devnet) or https://multihopper.com/api/v1 (mainnet)
MH_BASE_URL=https://devnet.multihopper.com/api/v1

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_hex_chars

# Signing secret returned once by POST /webhooks (whsec_...). Optional until you register a webhook.
MH_WEBHOOK_SECRET=

# --- Public (shipped to the browser) ---

# devnet or mainnet-beta. Must match MH_BASE_URL.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Use a dedicated RPC (Helius, Triton, QuickNode...) in production; the public endpoints are rate limited.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
